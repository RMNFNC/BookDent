DATABASE_URL="postgresql://postgres:password@localhost:5432/bookdent_flashcare"

# Chiave di firma dei token JWT: stringa casuale di almeno 32 caratteri.
# Generala con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Il server rifiuta di avviarsi se è mancante, troppo corta o se è ancora questo segnaposto.
JWT_SECRET="cambia-questa-chiave-con-una-stringa-lunga-e-casuale"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3000

# Origini del frontend autorizzate a chiamare le API (separate da virgola)
CORS_ORIGIN="http://localhost:5173"

# Documentazione Swagger su /api/docs (true/false)
SWAGGER_ENABLED=true
